{
  "name": "bwing",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --variant=prodDebug --appIdSuffix=apps",
    "ios": "react-native run-ios --simulator='iPhone 14 Pro'",
